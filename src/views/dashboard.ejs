<%- include('partials/header') %>

	<main>

		<h1>
			<%= title %>
		</h1>

		<h2>
			Dashboard
		</h2>

		<p>
			Name: <%= name %>
		</p>

		<p>
			Email: <%= email %>
		</p>

		<h3>
			My Volunteer Projects
		</h3>
		
		<% if (volunteerProjects.length> 0) { %>
		
			<ul>
				<% volunteerProjects.forEach(project=> 
				 { %>
					<li><a href="/project/<%= project.project_id %>"><%= project.title %></a> -
		       <a href="/project/<%= project.project_id %>/remove-volunteer">Remove Volunteer</a>
					</li>
					<% }) %>
			</ul>
			<% } 
			else 
			{ %>
				<p>You have not signed up for any projects yet.</p>
				<% } %>

		<% if (user && user.role_name==='admin' ) { %>

			<p>
				<a href="/users">Manage Users</a>
   </p>

			<% } %>

	</main>

	<%- include('partials/footer') %>